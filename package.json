{
  "name": "clinic-booking-api",
  "version": "1.0.0",
  "description": "Clinic booking API and web page (Koya Cohort 4, Task 1)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "test": "node --env-file=.env --test --test-concurrency=1 test/",
    "build": "vite build",
    "dev:web": "vite",
    "seed": "node --env-file=.env scripts/seed.js",
    "migrate": "node --env-file=.env scripts/migrate.js"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.5"
  }
}
